{
  "name": "folio-resume-studio",
  "version": "0.1.0",
  "description": "Local resume template reconstruction, document canvas, and truthful tailoring workspace.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:product": "vitest run --config vitest.product.config.ts",
    "test:engine": "vitest run",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "ai:check": "node --env-file-if-exists=server/.env.local server/config-check.mjs",
    "ai:server": "node --env-file-if-exists=server/.env.local server/index.mjs",
    "ai:test": "node --test server/adapter.test.mjs server/contract.test.mjs server/http.test.mjs server/protected-claims.test.mjs",
    "ai:test:historical": "node --test server/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "dejavu-fonts-ttf": "2.37.3",
    "docx-preview": "0.4.1",
    "idb": "8.0.3",
    "jszip": "3.10.2",
    "lucide-react": "1.51.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "@pdf-lib/upng": "1.0.1",
    "fontkit": "2.0.4",
    "@pdf-lib/standard-fonts": "1.0.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "pdfkit": "0.20.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
